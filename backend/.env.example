# Banco de dados (Neon PostgreSQL) — connection string oficial
DATABASE_URL=postgresql://user:password@ep-xxxx.us-east-1.aws.neon.tech/dbname?sslmode=require

# Origens permitidas no CORS (frontend)
CORS_ORIGINS=http://localhost:3000,https://seu-front.vercel.app

# Chave da API-Football usada pelos coletores ETL (o código lê APIFOOTBALL_KEY)
APIFOOTBALL_KEY=your_api_football_key

# Ambiente. Em "production" o backend se RECUSA a subir se o e-mail ou o JWT
# estiverem mal configurados — melhor derrubar o deploy do que aceitar cadastros
# cujo código de verificação nunca é entregue. Deixe "development" localmente.
APP_ENV=development

# Segredo de assinatura dos JWT. Obrigatório em produção (gere: openssl rand -hex 32).
JWT_SECRET=dev-insecure-change-me

# --- E-mail transacional (OTP de cadastro / recuperação de senha) ---
# mock = não envia, loga o código no console (só desenvolvimento).
# Em produção use zeptomail; smtp é o fallback.
EMAIL_PROVIDER=mock

# Remetente. Precisa estar num domínio verificado na Zoho (SPF + DKIM publicados).
EMAIL_FROM=no-reply@seudominio.com
EMAIL_FROM_NAME=ApostAI

# --- EMAIL_PROVIDER=zeptomail ---
# Painel ZeptoMail > Mail Agents > seu agente > Send Mail Token.
# Cole só o token; o prefixo "Zoho-enczapikey " é adicionado pelo código se faltar.
ZEPTOMAIL_TOKEN=
# Conta hospedada na UE: https://api.zeptomail.eu
ZEPTOMAIL_BASE_URL=https://api.zeptomail.com

# --- EMAIL_PROVIDER=smtp (fallback; Zoho Mail) ---
# Requer senha de aplicativo (Zoho Mail > Segurança > Senhas de aplicativo),
# NÃO a senha da conta. Porta 465 -> defina SMTP_STARTTLS=false.
SMTP_HOST=smtp.zoho.com
SMTP_PORT=587
SMTP_USER=contato@seudominio.com
SMTP_PASSWORD=
SMTP_STARTTLS=true

# --- Gateway de pagamento ---
# mock = confirma pagamentos sem cobrar de verdade (só desenvolvimento).
# Em produção use mercadopago.
PAYMENT_PROVIDER=mock
FRONTEND_BASE_URL=http://localhost:3000

# --- PAYMENT_PROVIDER=mercadopago (Checkout Pro) ---
# Painel MP > Developers > sua aplicação > Credenciais de produção/teste.
MP_ACCESS_TOKEN=
MP_PUBLIC_KEY=
# Painel MP > Webhooks > segredo de assinatura ("Assinatura secreta").
MP_WEBHOOK_SECRET=
MP_WEBHOOK_URL=https://seu-backend.onrender.com/payments/webhook/mercadopago

# --- Nota fiscal (NFS-e) ---
# noop = não emite nada de verdade, fica "pending" (só desenvolvimento).
# Em produção use nfeio.
INVOICE_PROVIDER=noop
NFEIO_API_BASE=https://api.nfe.io/v1
# Painel NFE.io (app.nfe.io) > Empresa > API Key / Company Id.
NFEIO_API_TOKEN=
NFEIO_COMPANY_ID=

# Dados fiscais da empresa emissora (não secretos, mas exigidos com INVOICE_PROVIDER=nfeio)
COMPANY_CNPJ=
COMPANY_RAZAO_SOCIAL=
COMPANY_ENDERECO=
COMPANY_INSCRICAO_MUNICIPAL=
COMPANY_CNAE=
COMPANY_CITY_SERVICE_CODE=
COMPANY_REGIME_TRIBUTARIO=
